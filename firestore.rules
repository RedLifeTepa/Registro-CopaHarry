rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reconoce al administrador autenticado en confi.html (hola@hola.com o cuenta Email/Password)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in ['hola@hola.com', 'admin@copaharry.com', 'harrygymcenter@gmail.com'] ||
        request.auth.token.firebase.sign_in_provider == 'password' ||
        request.auth.token.admin == true
      );
    }

    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /admins/{userId} {
      allow read, write: if request.auth != null;
    }

    // Permite que cualquier atleta desde cualquier celular/navegador pueda CREAR su inscripción,
    // y permite que el Administrador lea, actualice o elimine TODOS los registros sin bloqueos.
    match /registros_eventos/{registroId} {
      allow create: if request.resource.data.evento in ['Copa Harry', 'Powerlifting', 'Powerlift'];
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
