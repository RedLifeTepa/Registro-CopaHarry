rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Verifica que el usuario tenga sesión activa (Anónima para atletas o Email/Pass para Admin)
    function isSignedIn() {
      return request.auth != null;
    }

    // Verifica si el usuario autenticado es Administrador (vía Custom Claim admin:true o email autorizado)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email in [
          'admin@copaharry.com',
          'harrygymcenter@gmail.com'
        ]
      );
    }

    // Valida formato de teléfono mexicano a 10 dígitos
    function isValidPhone(phone) {
      return phone is string && phone.matches('^[0-9]{10}$');
    }

    // Valida estructura estricta con hasOnly() y tipos de datos al crear un registro
    function isValidRegistration(data) {
      let allowedKeys = [
        'id', 'folio', 'evento', 'fechaRegistro', 'timestamp',
        'estatusPago', 'montoTotal', 'avisoPrivacidadAceptado', 'uidCreador',
        'nombre', 'edad', 'diaNacimiento', 'mesNacimiento', 'anioNacimiento',
        'genero', 'numCategorias', 'ciudad', 'estado', 'domicilio',
        'coach', 'gimnasio', 'team', 'email', 'facebook', 'instagram',
        'celular', 'telefonoEmergencia', 'pesoCorporal',
        'catWoman1', 'catWoman2', 'catWoman3',
        'catMen1', 'catMen2', 'catMen3',
        'plCategorias', 'ejercicios', 'numEjercicios',
        'categoriasResumen', 'firmaDataUrl'
      ];

      return data.keys().hasOnly(allowedKeys)
        && data.keys().hasAll([
          'folio', 'evento', 'nombre', 'edad', 'celular',
          'montoTotal', 'estatusPago', 'avisoPrivacidadAceptado', 'categoriasResumen'
        ])
        && data.evento in ['Copa Harry', 'Powerlift']
        && data.folio is string && data.folio.matches('^(CH|PL)-[0-9]{8}-[0-9]{4}$')
        && data.nombre is string && data.nombre.size() >= 5 && data.nombre.size() <= 120
        && data.edad is number && data.edad >= 4 && data.edad <= 95
        && isValidPhone(data.celular)
        && data.montoTotal is number && data.montoTotal in [300, 400, 600, 800, 1000, 1400]
        && data.estatusPago == 'Pendiente'
        && data.avisoPrivacidadAceptado == true
        && data.categoriasResumen is string && data.categoriasResumen.size() >= 2 && data.categoriasResumen.size() <= 500;
    }

    match /registros_eventos/{registroId} {
      // Solo usuarios autenticados (incluyendo sesión anónima) pueden crear un registro válido
      allow create: if isSignedIn() && isValidRegistration(request.resource.data);

      // Solo administradores autenticados pueden leer, actualizar o borrar registros
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
